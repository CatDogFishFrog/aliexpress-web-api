# ── Required ──────────────────────────────────────────────────────────────
# Encryption key for sessions and accounts (at least 16 characters). Generate: `aliweb secret generate`
# WARNING: saved accounts and exported .bin files cannot be decrypted without this key.
ALIWEB_SESSION_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────
ALIWEB_DATA_DIR=./data

# ── Scraper browser ───────────────────────────────────────────────────────
# The scraper (API operations) always uses patchright (`patchright install chromium`).
# true = headless, false = show a window (for debugging).
# Choose the account login browser when running the login command, not here:
#   aliweb login <id>                                    headless, patchright browser
#   aliweb login <id> --headful --browser chrome|msedge  headful, Chrome or Edge (see README)
ALIWEB_HEADLESS=true
# Human-like input during login (character-by-character typing, mouse movement, scrolling, clicks).
# HUMAN_SPEED: speed multiplier from 0.3 to 3 (higher is faster).
ALIWEB_HUMAN_INPUT=true
ALIWEB_HUMAN_SPEED=1.0
# ── Account browser profile ────────────────────────────────────────────────
# The profile is created once per account and is not changed. The following settings only affect creation.
# Claimed OS: auto = this computer's OS (recommended) | windows | macos | linux
ALIWEB_FINGERPRINT_OS=auto
# Locale and timezone for new profiles (should match the IP country, e.g. en-US / America/New_York).
ALIWEB_LOCALE=en-US
ALIWEB_TIMEZONE=
# Format: WIDTHxHEIGHT or "none" (no_viewport).
ALIWEB_VIEWPORT=1366x768
ALIWEB_NAV_TIMEOUT_MS=45000
ALIWEB_ACTION_TIMEOUT_MS=15000
ALIWEB_SLOW_MO_MS=0
# Example: http://host:port (proxy username and password are configured separately).
ALIWEB_PROXY_SERVER=
ALIWEB_PROXY_USERNAME=
ALIWEB_PROXY_PASSWORD=

# ── Diagnostics and logs ───────────────────────────────────────────────────
# on_error | always | never
ALIWEB_DUMP_POLICY=on_error
ALIWEB_DUMP_KEEP=50
ALIWEB_SCREENSHOT_FULL_PAGE=true
ALIWEB_LOG_LEVEL=INFO
ALIWEB_LOG_JSON=false
ALIWEB_LOG_FILE=true

# ── AliExpress ─────────────────────────────────────────────────────────────
ALIWEB_BASE_URL=https://www.aliexpress.com
ALIWEB_LOGIN_URL=https://login.aliexpress.com/
# Session verification uses the login page by default; authenticated users are redirected away.
# Optionally specify another URL with ALIWEB_SESSION_PROBE_URL=.
# Empty = local logout only (clear the stored session).
ALIWEB_LOGOUT_URL=
# How long (seconds) to trust a verified session before checking it again.
ALIWEB_SESSION_VERIFY_TTL_S=600
