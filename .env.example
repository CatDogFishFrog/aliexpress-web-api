# ── Обов'язкове ────────────────────────────────────────────────────────────
# Ключ шифрування сесій/акаунтів (мінімум 16 символів). Згенерувати: `aliweb secret generate`
# УВАГА: без цього ключа збережені акаунти й експортовані .bin файли не розшифрувати.
ALIWEB_SESSION_SECRET=

# ── Сховище ────────────────────────────────────────────────────────────────
ALIWEB_DATA_DIR=./data

# ── Браузер ────────────────────────────────────────────────────────────────
ALIWEB_HEADLESS=true
# Порожньо = вбудований Chromium patchright; "chrome" = встановлений Google Chrome (рекомендовано patchright)
ALIWEB_BROWSER_CHANNEL=
ALIWEB_LOCALE=en-US
ALIWEB_TIMEZONE=
# Формат ШИРИНАxВИСОТА або "none" (no_viewport)
ALIWEB_VIEWPORT=1366x768
ALIWEB_NAV_TIMEOUT_MS=45000
ALIWEB_ACTION_TIMEOUT_MS=15000
ALIWEB_SLOW_MO_MS=0
# Приклад: http://host:port  (логін/пароль проксі — окремо)
ALIWEB_PROXY_SERVER=
ALIWEB_PROXY_USERNAME=
ALIWEB_PROXY_PASSWORD=

# ── Діагностика та логи ────────────────────────────────────────────────────
# on_error | always | never
ALIWEB_DUMP_POLICY=on_error
ALIWEB_DUMP_KEEP=50
ALIWEB_SCREENSHOT_FULL_PAGE=true
ALIWEB_LOG_LEVEL=INFO
ALIWEB_LOG_JSON=false
ALIWEB_LOG_FILE=true

# ── AliExpress ─────────────────────────────────────────────────────────────
ALIWEB_BASE_URL=https://www.aliexpress.com
ALIWEB_LOGIN_URL=https://login.aliexpress.com/
ALIWEB_SESSION_PROBE_URL=https://www.aliexpress.com/p/order/index.html
# Порожньо = вихід лише локальний (очищення сесії в сховищі)
ALIWEB_LOGOUT_URL=
# Як довго (сек) вважати перевірену сесію дійсною без повторної перевірки
ALIWEB_SESSION_VERIFY_TTL_S=600
